    "id": 2964622817828864,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "vllm-prometheus"
        },
        "description": "Engine time to first token; p50/p95 are histogram interpolation estimates over a rolling 1 minute. Includes engine queuing; distinct from client first-content latency. Zero observations produce NaN / no data.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 4,
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "spanNulls": false
            },
            "min": 0,
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "vllm-prometheus"
            },
            "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm\"}[1m])))",
